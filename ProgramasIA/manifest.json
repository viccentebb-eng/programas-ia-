{
  "manifestVersion": 5,
  "id": "mx.venegas.programasia",
  "name": "Programas IA",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "programasPanel",
      "label": {
        "default": "Programas IA"
      },
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 820
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.anthropic.com",
        "https://fonts.googleapis.com",
        "https://fonts.gstatic.com"
      ]
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    }
  }
}
